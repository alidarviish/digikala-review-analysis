    "masking": {
      "rate": 0.2,
      "rule": "inside each recommendation class of the train part, sort by stable_hash(id) = int(sha256(f'{MASK_SEED}|{id}').hexdigest()[:16], 16) and mask the first floor(rate * class_count) rows; ties broken by id",
      "rounding": "floor",
      "masked_total": 736134
    },
    "rating_band": {
      "edges": [
        2.5,
        4.0
      ],
      "definition": "low: 0 < rate < 2.5, medium: 2.5 <= rate < 4.0, high: 4.0 <= rate <= 5",
      "encoding": {
        "low": 0,
        "medium": 1,
        "high": 2
